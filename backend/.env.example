# UpperSilver Backend — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subir el .env real al repositorio.

# ─── Base de Datos (Cloud SQL / local) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=uppersilver

# Cloud SQL (solo en producción en GCP Cloud Run)
INSTANCE_CONNECTION_NAME=proyecto:region:instancia

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRATION=7d

# ─── Google Cloud ────────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# O como JSON inline para Secret Manager:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gmail API (para envío de emails transaccionales y marketing)
GMAIL_SENDER_EMAIL=no-reply@uppersilver.co

# ─── IA / OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Pagos — Wompi ──────────────────────────────────────────────────────────
# Obtener en: https://comercios.wompi.co/
WOMPI_PUBLIC_KEY=pub_
WOMPI_PRIVATE_KEY=prv_
# Secreto de eventos para validar la firma HMAC de los webhooks
WOMPI_EVENTS_SECRET=

# ─── Pagos — Mercado Pago ────────────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com.co/developers/
MP_ACCESS_TOKEN=APP_USR-...

# URL del frontend (para back_urls de Mercado Pago)
FRONTEND_URL=http://localhost:3000

# ─── Logística — Envíame ─────────────────────────────────────────────────────
# Obtener en: https://developer.enviame.io/
ENVIAME_API_KEY=

# ─── Logística — Coordinadora (contraentrega) ────────────────────────────────
# Obtener en: https://developer.coordinadora.com/
COORDINADORA_USER=
COORDINADORA_PASSWORD=

# ─── Notificaciones — WhatsApp Business (Meta) ───────────────────────────────
# Configurar en: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Notificaciones — Háblame.co (SMS / OTP) ─────────────────────────────────
# Obtener en: https://hablame.co/
HABLAME_API_KEY=
HABLAME_API_SECRET=
